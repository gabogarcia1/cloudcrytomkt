# URL of the CloudCryptoMarket agent (bag dev --port 9100 locally).
VITE_AGENT_URL=http://127.0.0.1:9100
# Optional: WalletConnect Cloud project id (https://cloud.reown.com). Without it
# only the injected wallet (MetaMask / Trust / Binance Web3 extension) is shown.
VITE_WC_PROJECT_ID=
# Network the storefront transacts on: bsc-testnet | bsc-mainnet
VITE_NETWORK=bsc-testnet
