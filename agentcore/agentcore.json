{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "cloudcryptomkt",
  "version": 1,
  "managedBy": "CDK",
  "runtimes": [
    {
      "name": "cloudcryptomkt",
      "build": "CodeZip",
      "entrypoint": "dist/dualMain.js",
      "codeLocation": "app/agent/",
      "networkMode": "PUBLIC",
      "protocol": "A2A",
      "envVars": [
        {
          "name": "OTEL_TRACES_EXPORTER",
          "value": "none"
        }
      ],
      "runtimeVersion": "NODE_22"
    }
  ]
}
